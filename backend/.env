# Backend environment variables for PulseCheck
#
# PORT — the port Express listens on.
# Override at runtime: PORT=8080 node server.js
# Or via Docker: -e PORT=8080
PORT=3001

# FRONTEND_ORIGIN — the allowed CORS origin.
# In development this is the Vite dev server.
# In production set to your frontend's public domain.
FRONTEND_ORIGIN=http://localhost:5173

# Frontend environment variables for PulseCheck
#
# VITE_API_BASE_URL — base URL of the backend API.
# In local development, leave this empty so Vite's dev-server proxy
# handles /api requests (configured in vite.config.js).
# In production, set to your backend's public URL, e.g.:
#   VITE_API_BASE_URL=https://api.pulsecheck.example.com
VITE_API_BASE_URL=
